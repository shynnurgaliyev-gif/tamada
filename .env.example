# App
NODE_ENV=development
APP_NAME=tamada-api
APP_PORT=3000
APP_BASE_URL=https://tamada-api.onrender.com
LOG_LEVEL=info

# Database (Supabase)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_EXPIRES_DAYS=30

# WhatsApp
WHATSAPP_PROVIDER=stub
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Web (for apps/web only)
NEXT_PUBLIC_API_URL=https://tamada-api.onrender.com
