# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=tamada-api
APP_PORT=3000
APP_BASE_URL=https://tamada-api.onrender.com
LOG_LEVEL=info

# ── Database (Supabase) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_EXPIRES_DAYS=30

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (production only)
CORS_ORIGINS=https://tamada.kz,https://www.tamada.kz

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=stub
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tamada_bot

# ── Jobs / Reminders ──────────────────────────────────────────────────────────
INTERNAL_JOBS_SECRET=change-me-to-a-random-secret
CALENDAR_STALE_DAYS=7
DEFAULT_MORNING_REMINDER_HOUR=9

# ── Payments ─────────────────────────────────────────────────────────────────
KASPI_API_KEY=

# ── AI Search ─────────────────────────────────────────────────────────────────
AI_SEARCH_ENABLED=false
OPENAI_API_KEY=
AI_SEARCH_MODEL=gpt-4o-mini

# ── Web (apps/web only) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://tamada-api.onrender.com
NEXT_PUBLIC_WEB_URL=https://tamada.kz

# ── Telegram Mini App ──────────────────────────────────────────────────────────
# Telegram bot/miniapp link shown on marketing pages.
# Format for bot-only: https://t.me/OctiqaBot
# Format for Web App:  https://t.me/OctiqaBot/octiqa  (where "octiqa" is the Web App short name set in BotFather)
NEXT_PUBLIC_TG_APP_URL=https://t.me/OctiqaBot

# Web URL of the Mini App shell — set this as "Menu Button URL" in BotFather.
# Format: https://octiqa.kz/mini
NEXT_PUBLIC_MINI_URL=https://octiqa.kz/mini
